{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "https://raw.githubusercontent.com/joaomj/skills/main/AGENTS.md"
  ],
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "npm *": "ask",
      "rm *": "ask",
      "ssh *": "ask",
      "brew *": "ask",
      "* .env *": "ask",
      "docker *": "ask"
    },
    "skill": {
      "*": "allow"
    }
  },
  "small_model": "opencode-go/minimax-m2.5",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 100000
  },
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "minimax-m2.7": {
          "name": "MiniMax M2.7",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        },
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        },
        "kimi-k3.6": {
          "name": "Kimi K3.6",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        },
        "qwen3.6-plus": {
          "name": "Qwen 3.6 Plus",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    }
  }
}
