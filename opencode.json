{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "mv *": "ask",
      "pip *": "ask",
      "uv *": "ask",
      "npm *": "ask",
      "rm *": "ask",
      "ssh *": "ask",
      "brew *": "ask",
      "docker *": "ask",
      "*/.env": "deny",
      "*/.env *": "deny",
      "* .env": "deny",
      "* .env *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "websearch": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "small_model": "opencode/deepseek-v4-flash-free",
  "compaction": {
    "auto": true,
    "prune": true
    //"reserved": 100000
  },
  "agent": {
    "compaction": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 150000,
            "input": 150000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "max"
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 150000,
            "input": 150000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "max"
          }
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "limit": {
            "context": 150000,
            "input": 150000,
            "output": 64000
          }
        }
      }
    }
  }
}
