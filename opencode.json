{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "date": "allow",
      "whoami": "allow",
      "id": "allow",
      "uname *": "allow",
      "arch": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -vv": "allow",
      "git rev-parse *": "allow",
      "git merge-base *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git grep *": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "mv *": "ask",
      "pip *": "ask",
      "uv *": "ask",
      "npm *": "ask",
      "rm *": "ask",
      "ssh *": "ask",
      "brew *": "ask",
      "docker *": "ask",
      "*.env*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "small_model": "openai/gpt-5.4-nano",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "compaction": {
      "model": "openai/gpt-5.4-nano"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 150000,
            "input": 150000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 150000,
            "input": 150000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  }
}
