{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "https://raw.githubusercontent.com/joaomj/skills/main/AGENTS.md"
  ],
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "npm *": "ask",
      "rm *": "ask",
      "ssh *": "ask",
      "brew *": "ask",
      "* .env *": "ask",
      "docker *": "ask"
    },
    "skill": {
      "*": "allow"
    }
  },
  "small_model": "opencode-go/minimax-m2.5",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 100000
  },
  "agent": {
    "explore": {
      "model": "opencode-go/minimax-m2.7"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.3-codex": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "zai-coding-plan": {
      "models": {
        "glm-5.1": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "minimax-m2.7": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "glm-5.1": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "qwen3.6-plus": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "minimax-m2.5": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}
