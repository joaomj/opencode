{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["instructions/AGENTS.md", "instructions/style.md"],
  "autoupdate": false,
  "small_model": "opencode/deepseek-v4-flash-free",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "compaction": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "date": "allow",
      "whoami": "allow",
      "id": "allow",
      "uname *": "allow",
      "arch": "allow",
      "which *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -vv": "allow",
      "gh auth status": "allow",
      "gh browse *": "allow",
      "gh help *": "allow",
      "gh pr checks *": "allow",
      "gh pr checkout *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr status": "allow",
      "gh pr view *": "allow",
      "gh repo list *": "allow",
      "gh repo view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh search *": "allow",
      "gh status": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "*.env*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    }
  }
}
