{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "https://raw.githubusercontent.com/joaomj/skills/main/AGENTS.md"
  ],
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "npm *": "ask",
      "rm *": "ask",
      "ssh *": "ask",
      "brew *": "ask",
      "cat .env *": "deny",
      "* .env *": "deny",
      "docker *": "ask"
    },
    "skill": {
      "*": "allow"
    }
  },
  "small_model": "opencode-go/minimax-m2.5",
  "agent": {
    "code-reviewer-1": {
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "temperature": 0.1,
      "reasoningEffort": "high",
      "hidden": true,
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      },
      "permission": {
        "bash": {
          "git *": "allow"
        }
      }
    },
    "code-reviewer-2": {
      "mode": "subagent",
      "model": "opencode-go/glm-5",
      "temperature": 0.1,
      "hidden": true,
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      },
      "permission": {
        "bash": {
          "git *": "allow"
        }
      }
    }
  },
  "provider": {
    "lmstudio-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": { "baseURL": "http://127.0.0.1:1234/v1" },
      "models": {
        "qwen3.5-9b-mlx": { "name": "Qwen3.5-9B MLX (local)" }
      }
    }
  }
}
