{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "https://raw.githubusercontent.com/joaomj/skills/main/AGENTS.md"
  ],
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "npm *": "ask",
      "rm *": "ask",
      "ssh *": "ask",
      "brew *": "ask",
      "* .env *": "ask",
      "docker *": "ask"
    },
    "skill": {
      "*": "allow"
    }
  },
  "small_model": "openai/gpt-5.4-mini",
  "agent": {
    "explore": {
      "model": "openai/gpt-5.4-mini"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.3-codex": {
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "zai-coding-plan": {
      "models": {
        "glm-5.1": {
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "minimax-m2.7": {
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        },
        "glm-5.1": {
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}
