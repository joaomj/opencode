{
  "$schema": "https://opencode.ai/config.json",
  // Instructions: Remote AGENTS.md that serves as the primary guidelines source.
  // The local AGENTS.md overrides any rules from this remote file.
  // If you fork or customize, update this URL to point to your own repo.
  "instructions": [
    "https://raw.githubusercontent.com/joaomj/skills/main/AGENTS.md"
  ],
  // Autoupdate: If true, opencode will check for updates to this config periodically.
  // Set to false if you want full control over when to update.
  "autoupdate": true,
  // Permission: Controls which tools the agent can use without asking.
  // Customize based on your comfort level. Default is to allow most but
  // ask for destructive operations (git push, rm, docker, etc.).
  "permission": {
    "bash": {
      "*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "npm *": "ask",
      "rm *": "ask",
      "ssh *": "ask",
      "brew *": "ask",
      "* .env *": "ask",
      "docker *": "ask"
    },
    "skill": {
      "*": "allow"
    }
  },
  // Small model: Used for quick tasks and the explore agent.
  // Should be fast and cheap. Examples: gpt-4o-mini, claude-3-haiku.
  "small_model": "<YOUR_SMALL_MODEL_HERE>",
  // Compaction: Controls context window management.
  // auto=true enables automatic compaction.
  // prune=true removes old messages when context fills.
  // reserved=bytes to reserve for response.
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 100000
  },
  // Agent-specific model overrides.
  "agent": {
    "explore": {
      // Model for the explore agent. Should be fast for scanning codebases.
      "model": "<YOUR_EXPLORE_MODEL_HERE>"
    }
  },
  // Provider configuration: Add your API providers and models here.
  // Only include providers you have API keys for.
  // Keys should be set as environment variables, NOT in this file.
  // Example: OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
  "provider": {
    // Example: OpenAI
    "openai": {
      "models": {
        "<YOUR_OPENAI_MODEL>": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    },
    // Example: Anthropic
    "anthropic": {
      "models": {
        "<YOUR_ANTHROPIC_MODEL>": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    },
    // Example: OpenCode provider
    "opencode-go": {
      "models": {
        "<YOUR_OPENCODE_MODEL>": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    }
  }
}
