{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "autoupdate": "notify",
  "snapshot": false,
  "subagent_depth": 1,
  "small_model": "opencode/deepseek-v4-flash-free",
  "compaction": {
    "auto": true,
    "prune": true
  },
  /*"mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    }
  },*/
  "agent": {
    "compaction": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git checkout -- *": "deny",
      "git clean -f*": "deny",
      "docker run --privileged *": "deny",
      "curl *github.com*": "deny",
      "wget *github.com*": "deny",
      "gh api --method PUT *": "deny",
      "gh api --method PATCH *": "deny",
      "pip": "deny",
      "pip *": "deny",
      "pip3": "deny",
      "pip3 *": "deny",
      "python": "deny",
      "python *": "deny",
      "python3": "deny",
      "python3 *": "deny",
      "pytest": "deny",
      "pytest *": "deny",
      "ruff": "deny",
      "ruff *": "deny",
      "mypy": "deny",
      "mypy *": "deny",
      "pyright": "deny",
      "pyright *": "deny",
      "coverage": "deny",
      "coverage *": "deny",
      "tox": "deny",
      "tox *": "deny",
      "nox": "deny",
      "nox *": "deny",
      "poetry": "deny",
      "poetry *": "deny",
      "pipenv": "deny",
      "pipenv *": "deny",
      "conda": "deny",
      "conda *": "deny",
      "chown *": "deny",
      "sudo *": "deny",
      "pwd": "allow",
      "date": "allow",
      "whoami": "allow",
      "id": "allow",
      "uname *": "allow",
      "arch": "allow",
      "which *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "deny",
      "wc *": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -vv": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git rebase *": "allow",
      "gh auth status": "allow",
      "gh browse *": "allow",
      "gh help *": "allow",
      "gh pr checks *": "allow",
      "gh pr checkout *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr status": "allow",
      "gh pr view *": "allow",
      "gh repo list *": "allow",
      "gh repo view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh search *": "allow",
      "gh status": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "ag *": "allow",
      "ack *": "allow",
      "basename *": "allow",
      "cat *": "allow",
      "cut *": "allow",
      "df *": "allow",
      "dig *": "allow",
      "dirname *": "allow",
      "docker compose config *": "allow",
      "docker compose images *": "allow",
      "docker compose logs *": "allow",
      "docker compose ps *": "allow",
      "docker images *": "allow",
      "docker info *": "allow",
      "docker inspect *": "allow",
      "docker logs *": "allow",
      "docker network ls *": "allow",
      "docker network inspect *": "allow",
      "docker ps *": "allow",
      "docker stats *": "allow",
      "docker system df *": "allow",
      "docker version *": "allow",
      "docker volume ls *": "allow",
      "docker volume inspect *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "env": "deny",
      "fd *": "allow",
      "file *": "allow",
      "find *": "allow",
      "fmt *": "allow",
      "head *": "allow",
      "host *": "allow",
      "hostname *": "allow",
      "nl *": "allow",
      "nslookup *": "allow",
      "ping *": "allow",
      "printenv *": "deny",
      "printf *": "allow",
      "ps *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "tr *": "allow",
      "tty": "allow",
      "type *": "allow",
      "uniq *": "allow",
      "uptime": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "ask",
    "todowrite": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    },
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 150000,
            "input": 150000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "max"
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 150000,
            "input": 150000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  }
}
