{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "autoupdate": "notify",
  "snapshot": false,
  "subagent_depth": 1,
  "small_model": "opencode/hy3-free",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "compaction": {
      "model": "opencode/hy3-free"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "none",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          }
        }
      }
    },
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 150000,
            "input": 150000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "task": "deny",
    "bash": {
      "*": "ask",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git checkout -- *": "deny",
      "git clean -f*": "deny",
      "docker run --privileged *": "deny",
      "curl *github.com*": "deny",
      "wget *github.com*": "deny",
      "gh *": "allow",
      "gh * | *": "allow",
      "gh *|*": "allow",
      "gh * && *": "allow",
      "gh *&&*": "allow",
      "gh * || *": "allow",
      "gh *||*": "allow",
      "gh *; *": "allow",
      "gh *;*": "allow",
      "gh api --method POST *": "ask",
      "gh api --method PATCH *": "ask",
      "gh api --method PUT *": "ask",
      "gh api --method DELETE *": "ask",
      "gh api -X POST *": "ask",
