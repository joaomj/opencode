{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "autoupdate": "notify",
  "snapshot": false,
  "plugin": [
    "./plugins/policy-gate.ts",
    "~/projects/opencode-cache-hit"
  ],
  "subagent_depth": 0,
  "model": "opencode/muse-spark-1.2-contributor-free",
  "small_model": "opencode/muse-spark-1.2-contributor-free",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "title": {
      "options": {
        "reasoningEffort": "low"
      }
    },
    "explore": {
      "model": "openrouter/meta/muse-spark-1.2-contributor",
      "reasoningEffort": "high",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "setCacheKey": true
      },
      "models": {
        "gpt-5.6-luna-fast": {
          "name": "GPT 5.6 Luna Fast",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.6-sol-fast": {
          "name": "GPT 5.6 Sol Fast",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    },
    "opencode": {
      "models": {
        "muse-spark-1.2-contributor-free": {
          "name": "Muse Spark 1.2 Free",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "meta/muse-spark-1.2-contributor": {
          "name": "Muse Spark 1.2 Contributor",
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "task": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "date": "allow",
      "whoami": "allow",
      "id": "allow",
      "uname -a": "allow",
      "arch": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "git status --porcelain": "allow",
      "git diff": "allow",
      "git diff --cached": "allow",
      "git log": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -vv": "allow",
      "gh auth status": "allow",
      "gh status": "allow",
      "docker images": "allow",
      "docker info": "allow",
      "docker ps": "allow",
      "docker version": "allow",
      "hostname": "allow",
      "ps": "allow",
      "tty": "allow",
      "uptime": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.netrc": "deny",
      "*.authinfo": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*credentials": "deny",
      "*credentials*.json": "deny",
      "**/.docker/config.json": "deny",
      "**/.config/gh/hosts.yml": "deny"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.netrc": "deny",
      "*.authinfo": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*credentials": "deny",
      "*credentials*.json": "deny",
      "**/.docker/config.json": "deny",
      "**/.config/gh/hosts.yml": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "/private/var/tmp/**": "allow",
      "/var/folders/**/T/**": "allow",
      "/private/var/folders/**/T/**": "allow"
    }
  }
}
