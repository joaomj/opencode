[Unit]
Description=Teams headless browser authentication daemon
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.config/opencode/skills/teams-brave-cli
Environment=TEAMS_CDP_BROWSER=/snap/bin/chromium
Environment=TEAMS_CDP_PROFILE=%h/snap/chromium/common/teams-authd-profile
ExecStart=%h/.config/opencode/skills/teams-brave-cli/.venv/bin/teams-authd
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target
