#!/usr/bin/env python3
import urllib.request
import json
import sys
import socket
import struct
import base64
import time

MASK_KEY = bytes([0x0B, 0xAD, 0xBE, 0xEF])

def ws_connect(ws_url):
    if ws_url.startswith('wss'):
        raise Exception("wss not supported")
    ws_url = ws_url.replace('ws://', '')
    parts = ws_url.split('/')
    host_port = parts[0].split(':')
    host = host_port[0]
    port = int(host_port[1]) if len(host_port) > 1 else 9222
    path = '/' + '/'.join(parts[1:]) if len(parts) > 1 else '/'
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.connect((host, port))
    sock.settimeout(30)
    key = base64.b64encode(bytes([(i * 17 + 42) % 256 for i in range(16)])).decode()
    req = f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
    sock.sendall(req.encode())
    resp = b''
    while b'\r\n\r\n' not in resp:
        resp += sock.recv(1)
    if b'101' not in resp:
        raise Exception("Handshake failed: no 101")
    return sock

def ws_send_json(sock, obj):
    data = json.dumps(obj).encode()
    length = len(data)
    masked = bytes([data[i] ^ MASK_KEY[i % 4] for i in range(length)])
    if length <= 125:
        frame = struct.pack('!BB4s', 0x81, 0x80 | length, MASK_KEY)
    elif length <= 65535:
        frame = struct.pack('!BBH4s', 0x81, 0xFE, length, MASK_KEY)
    else:
        frame = struct.pack('!BBQ4s', 0x81, 0xFF, length, MASK_KEY)
    sock.sendall(frame + masked)

def ws_recv_json(sock):
    header = b''
    while len(header) < 2:
        chunk = sock.recv(2 - len(header))
        if not chunk:
            return None
        header += chunk
    opcode = header[0] & 0x0F
    length = header[1] & 0x7F
    if length == 126:
        ext = b''
        while len(ext) < 2:
            chunk = sock.recv(2 - len(ext))
            if not chunk:
                return None
            ext += chunk
        length = struct.unpack('!H', ext)[0]
    elif length == 127:
        ext = b''
        while len(ext) < 8:
            chunk = sock.recv(8 - len(ext))
            if not chunk:
                return None
            ext += chunk
        length = struct.unpack('!Q', ext)[0]
    payload = b''
    while len(payload) < length:
        chunk = sock.recv(length - len(payload))
        if not chunk:
            break
        payload += chunk
    if opcode == 0x8:
        return None
    return json.loads(payload.decode())

def cdp_call(sock, method, params=None, timeout=10):
    msg_id = int(time.time() * 1000) & 0x7FFFFFFF
    ws_send_json(sock, {'id': msg_id, 'method': method, 'params': params or {}})
    deadline = time.time() + timeout
    sock.settimeout(1)
    while time.time() < deadline:
        try:
            resp = ws_recv_json(sock)
            if resp is None:
                break
            if 'id' not in resp:
                continue
            if resp.get('id') == msg_id:
                return resp
        except socket.timeout:
            continue
    raise Exception(f"CDP call {method} timed out")

def main():
    args = sys.argv[1:]
    host = 'localhost'
    port = 9222
    output = None
    fmt = 'png'
    quality = 80
    full_page = False
    selector = None
    i = 0
    while i < len(args):
        if args[i] == '--host' and i + 1 < len(args):
            host = args[i + 1]; i += 2
        elif args[i] == '--port' and i + 1 < len(args):
            port = int(args[i + 1]); i += 2
        elif args[i] == '--output' and i + 1 < len(args):
            output = args[i + 1]; i += 2
        elif args[i] == '--format' and i + 1 < len(args):
            fmt = args[i + 1]; i += 2
        elif args[i] == '--quality' and i + 1 < len(args):
            quality = int(args[i + 1]); i += 2
        elif args[i] == '--full-page':
            full_page = True; i += 1
        elif args[i] == '--selector' and i + 1 < len(args):
            selector = args[i + 1]; i += 2
        else:
            i += 1
    try:
        with urllib.request.urlopen(f'http://{host}:{port}/json') as r:
            targets = json.loads(r.read())
        pages = [t for t in targets if t.get('type') == 'page']
        if not pages:
            raise Exception('No page targets found. Open a tab in Brave.')
        sock = ws_connect(pages[0]['webSocketDebuggerUrl'])
        cdp_call(sock, 'Page.enable')
        if full_page:
            dim_resp = cdp_call(sock, 'Runtime.evaluate', {'expression': 'JSON.stringify({w: document.documentElement.scrollWidth, h: document.documentElement.scrollHeight})', 'returnByValue': True})
            dim = json.loads(dim_resp['result']['result']['value'])
            cdp_call(sock, 'Emulation.setDeviceMetricsOverride', {'width': int(dim['w']), 'height': int(dim['h']), 'deviceScaleFactor': 1})
        clip = None
        if selector:
            sel_resp = cdp_call(sock, 'Runtime.evaluate', {'expression': f'JSON.stringify(document.querySelector("{selector}").getBoundingClientRect())', 'returnByValue': True})
            rect = json.loads(sel_resp['result']['result']['value'])
            clip = {'x': rect['left'], 'y': rect['top'], 'width': rect['width'], 'height': rect['height'], 'scale': 1}
        params = {'format': fmt, 'quality': quality}
        if clip:
            params['clip'] = clip
        resp = cdp_call(sock, 'Page.captureScreenshot', params)
        data = resp['result']['data']
        if output:
            with open(output, 'wb') as f:
                f.write(base64.b64decode(data))
            print(json.dumps({'format': fmt, 'path': output}))
        else:
            sys.stdout.write(base64.b64decode(data).decode('latin-1'))
        sys.exit(0)
    except Exception as e:
        print(json.dumps({'error': str(e), 'hint': 'Ensure Brave is running with --remote-debugging-port=9222'}))
        sys.exit(1)

if __name__ == '__main__':
    main()